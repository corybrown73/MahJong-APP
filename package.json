{
  "name": "bahay",
  "private": true,
  "version": "0.1.0",
  "description": "Báhay — Filipino (16-tile) mahjong",
  "scripts": {
    "test": "pnpm --filter @bahay/engine test && pnpm --filter @bahay/ai test && pnpm --filter @bahay/room test",
    "typecheck": "pnpm -r typecheck",
    "play": "pnpm --filter @bahay/ai play",
    "mobile": "pnpm --filter @bahay/mobile start",
    "bundle:room": "node scripts/bundle-room.mjs",
    "room:dev": "node scripts/dev-room-server.mjs",
    "web": "pnpm --filter @bahay/mobile web",
    "build:web": "pnpm --filter @bahay/mobile build:web",
    "serve:web": "pnpm --filter @bahay/mobile serve:web"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^2.1.8",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@9.12.3"
}
