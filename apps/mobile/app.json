{
  "expo": {
    "name": "Báhay",
    "slug": "bahay",
    "scheme": "bahay",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0C0907",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C0907"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bahay.mahjong"
    },
    "android": {
      "package": "com.bahay.mahjong",
      "adaptiveIcon": {
        "backgroundColor": "#0C0907",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "name": "Báhay — Filipino Mahjong",
      "shortName": "Báhay",
      "description": "Filipino 16-tile mahjong at the family table. Play the house in your browser, or open a table and read the code out to family.",
      "themeColor": "#0C0907",
      "backgroundColor": "#0C0907",
      "lang": "en",
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
